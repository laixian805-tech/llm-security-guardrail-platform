{
  "$defs": {
    "Confidence": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RiskDimension": {
      "additionalProperties": false,
      "description": "一个风险维度的得分及其计算依据。\n\n为什么必须有这个结构：原来三个维度只有三个浮点数，\"Intrinsic 为什么是\n95\"答不出来——查表得来的数字和算出来的数字在库里长得一样。confidence\n由证据充分度计算，不是人工填写：没有证据的维度记 UNKNOWN 而不是 0，\n否则\"没测\"会被读成\"没有风险\"。",
      "properties": {
        "basis": {
          "default": "",
          "maxLength": 2048,
          "title": "Basis",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "unknown"
        },
        "dimension": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "rule_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "score",
        "rule_version"
      ],
      "title": "RiskDimension",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "unknown"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/RiskDimension"
      },
      "maxItems": 8,
      "title": "Dimensions",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "exposure_risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Exposure Risk",
      "type": "number"
    },
    "intrinsic_risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Intrinsic Risk",
      "type": "number"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Reasons",
      "type": "array"
    },
    "rule_version": {
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "runtime_risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Runtime Risk",
      "type": "number"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "intrinsic_risk",
    "runtime_risk",
    "exposure_risk",
    "rule_version",
    "created_at",
    "updated_at"
  ],
  "title": "RiskAssessment",
  "type": "object"
}
