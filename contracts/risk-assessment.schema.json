{
  "$defs": {
    "Confidence": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "unknown"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "exposure_risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Exposure Risk",
      "type": "number"
    },
    "intrinsic_risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Intrinsic Risk",
      "type": "number"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Reasons",
      "type": "array"
    },
    "rule_version": {
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "runtime_risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Runtime Risk",
      "type": "number"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "intrinsic_risk",
    "runtime_risk",
    "exposure_risk",
    "rule_version",
    "created_at",
    "updated_at"
  ],
  "title": "RiskAssessment",
  "type": "object"
}
