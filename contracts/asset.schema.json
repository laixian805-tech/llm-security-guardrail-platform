{
  "$defs": {
    "AssetType": {
      "enum": [
        "agent",
        "skill",
        "mcp_server",
        "plugin",
        "tool"
      ],
      "title": "AssetType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "逻辑治理对象。",
  "properties": {
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "asset_type": {
      "$ref": "#/$defs/AssetType"
    },
    "canonical_name": {
      "minLength": 1,
      "title": "Canonical Name",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "namespace": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Namespace"
    },
    "product": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product"
    },
    "provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance"
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "asset_type",
    "canonical_name",
    "created_at",
    "updated_at"
  ],
  "title": "Asset",
  "type": "object"
}
