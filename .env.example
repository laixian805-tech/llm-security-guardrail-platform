# ASGP 默认以 StepFun 为主用模型供应商。
ASGP_MODEL_PROVIDER=stepfun
STEPFUN_API_KEY=
STEPFUN_CHAT_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-5-preview

# 讯飞星火作为候选。切换前须配置并验证 Chat Completions 接口和模型。
XUNFEI_API_PASSWORD=
XUNFEI_CHAT_BASE_URL=
XUNFEI_MODEL=

# Snyk Agent Scan 需要此令牌；只保存在本机 .env 中。
SNYK_TOKEN=

# 默认从 ~/.codex/config.toml 读取供应商地址/协议及各自的 Authorization Bearer 头。
# 密钥只在内存中回退使用，不回显、不写盘；可用显式环境变量覆盖。
CODEX_CONFIG_PATH=
