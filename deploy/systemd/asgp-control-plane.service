[Unit]
Description=ASGP control plane
After=network.target
[Service]
Type=simple
WorkingDirectory=/root/agent-security-fusion-platform
EnvironmentFile=/root/.asgp/control-plane/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/agent-security-fusion-platform/.venvs/control-plane/bin/python backend/server.py
Restart=on-failure
RestartSec=5
MemoryMax=768M
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
